# Server
PORT=8080
HOST=0.0.0.0

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?appName=Cluster0
MONGODB_DB=aurum_markets

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Upstream sportsbook (optional)
UPSTREAM=https://iframedev1.thesportslab.eu
BS_UPSTREAM=https://bs-iframedev1.thesportslab.eu

PROXY_DEBUG=

# Overview page: proxy = original sportsbook SPA (default), custom = AURUM markets UI
OVERVIEW_SHELL=proxy

# OpenAI — AI translation in Admin → Languages
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
